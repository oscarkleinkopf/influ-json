{
  "name": "influ-json",
  "version": "1.0.0",
  "description": "Estudio local de UGC con influencers virtuales \u2014 prompts + character_lock JSON para chatbots gratis",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:minimal": "node server-minimal.js",
    "dev": "node --watch server.js",
    "doctor": "node scripts/doctor.js",
    "support-bundle": "node scripts/support-bundle.js",
    "pack:release": "node scripts/pack-release.js",
    "build:index": "node scripts/build-index.js",
    "test": "node scripts/run-tests.js",
    "test:raw": "DISABLE_GIT_BACKUP=1 ENABLE_GIT_BACKUP= INFLU_SKIP_ENV_PERSIST=1 node --test --test-concurrency=1 test/*.test.js",
    "smoke": "DISABLE_GIT_BACKUP=1 ENABLE_GIT_BACKUP= INFLU_SKIP_ENV_PERSIST=1 INFLU_SKIP_DB_MIGRATE=1 node scripts/run-smoke.js",
    "layout-smoke": "node scripts/layout-smoke.js",
    "walkthrough": "node scripts/happy-path-walkthrough.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ugc",
    "influencer",
    "character-lock",
    "pollinations"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "archiver": "^8.0.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "express-session": "^1.19.0",
    "multer": "^2.2.0",
    "sharp": "^0.35.3",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "puppeteer-core": "^24.2.0"
  }
}
