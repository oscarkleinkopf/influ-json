# influ-JSON Studio — copy to .env and fill in
#
# FREE-FIRST: the app works without any paid image API.
# Small entrepreneurs should not need a credit card for the basic loop.

# ─── Core (optional) ───────────────────────────────────────────
# Google Gemini (optional; without it → offline / prompt-copy + Pollinations)
GEMINI_API_KEY=

# Bind address (default: localhost only — safe for local Studio)
# HOST=127.0.0.1
# PORT=3000
# To expose on LAN you MUST set HOST=0.0.0.0 AND a non-default STUDIO_PIN (not 1234, not empty).
# With HOST=0.0.0.0 + default PIN OR empty STUDIO_PIN (auth off), protected /api/* returns 503.

# Studio PIN
# - Default 1234 → first-run wizard (change it; min 6 chars).
# - Empty STUDIO_PIN= → auth OFF (solo seguro con HOST=127.0.0.1; en 0.0.0.0 la API se bloquea).
STUDIO_PIN=1234

# Session secret (auto-generated on first start if missing; set explicitly in production)
# SESSION_SECRET=cambia-este-secreto-largo-aleatorio
# COOKIE_SECURE=1
# LOGIN_MAX_FAILS=5
# LOGIN_LOCK_MS=60000

# Auto git commit/push from the server — OFF by default (opt-in).
# Only enable if you intentionally want every mutation to push to origin/main.
# ENABLE_GIT_BACKUP=1
#
# Local SQLite snapshots in data/backups/ (not git). Keep newest N after each create.
# BACKUP_KEEP=10
#
# Hard-disable (tests / CI / safety):
# DISABLE_GIT_BACKUP=1
#
# Legacy root mirrors ./influ.sqlite + ./personas.json (OFF by default; W6).
# Source of truth is always data/influ.sqlite. Prefer Ajustes → Backup / export studio.
# ENABLE_LEGACY_MIRRORS=1

# ─── Data ──────────────────────────────────────────────────────
# Optional: absolute path for SQLite + mirrors (default: ./data)
# DATA_DIR=C:\path\to\your\data

# Optional: one-time migration source for old Antigravity scratch DB
# LEGACY_SCRATCH_DIR=C:\Users\you\.gemini\antigravity\brain\...\scratch

# ─── Image generation ──────────────────────────────────────────
# Default: pollinations
IMAGE_PROVIDER=pollinations

# IMPORTANT (2026): Pollinations migró a créditos "pollen" y su API moderna
# (gen.pollinations.ai/image) EXIGE un token Bearer. El acceso ANÓNIMO ya no
# genera imágenes → 401 (no autorizado) / 402 "Insufficient balance".
# Sigue siendo CERO COSTO si te registras: los grants diarios gratis cubren flux.
#   1. Entra a https://enter.pollinations.ai/keys (login con GitHub) y crea una API key.
#      Para backend usa una key server-to-server (empieza con sk_ ; también valen pk_).
#   2. Pégala aquí. Sin tarjeta de crédito.
POLLINATIONS_TOKEN=
# IMPORTANTE: al crear la key en enter.pollinations.ai/keys, dale el permiso
# `account:usage` (o asígnale un pollenBudget). Sin eso, la key no puede gastar
# los grants gratis de la cuenta y toda generación devuelve 402 "Insufficient balance".
#
# Modelo de imagen (opcional). Todos cuestan pollen ahora.
#   flux (default): mejor calidad (~0.002/img) · dreamshaper: ~20x más barato (~0.0001/img)
# POLLINATIONS_MODEL=flux
#
# Opcional: dominio/identificador de tu app (para keys de front pk_ vía referrer).
# POLLINATIONS_REFERRER=influ-json.local

# Future optional paid face-lock (NOT required). When unimplemented or
# token missing, the app always falls back to Pollinations.
# IMAGE_PROVIDER=replicate
# REPLICATE_API_TOKEN=
# REPLICATE_FACE_MODEL=   # e.g. InstantID / PuLID model version when wired

# Future self-host LoRA inference (Fase L / L2 + L4 hub — opt-in)
# Sin URLs locales, generateWithLora intenta L3 (si está on) o cae a Pollinations.
# COMFYUI_URL=http://127.0.0.1:8188
# COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors
# COMFYUI_LORAS_DIR=/path/to/ComfyUI/models/loras
# COMFYUI_WORKFLOW_JSON=./docs/lora/comfy_workflow_template.json
#
# L4 — Automatic1111 / Forge (misma API /sdapi/v1). FORGE_URL es alias de A1111_URL.
# A1111_URL=http://127.0.0.1:7860
# FORGE_URL=http://127.0.0.1:7860
# A1111_LORAS_DIR=/path/to/stable-diffusion-webui/models/Lora
# LOCAL_GPU_BACKEND=auto
# PREFER_LOCAL_GPU=1
# Ver docs/lora/L4_LOCAL_GPU.md
#
# IMAGE_PROVIDER=comfyui
# COMFYUI_URL=http://127.0.0.1:8188

# Fase L / L3 — Trainer + inferencia LoRA de PAGO (Replicate). OPT-IN explícito.
# Sin ENABLE_PAID_LORA=1 el Studio NUNCA llama a Replicate para LoRA (path free intacto).
# ENABLE_PAID_LORA=1
# REPLICATE_API_TOKEN=
# REPLICATE_USERNAME=tu_usuario
# REPLICATE_LORA_TRAINER=ostris/flux-dev-lora-trainer:d995297071a44dcb72244e6c19462111649ec86a9646c32df56daa7f14801944
# Ver docs/lora/L3_PAID.md
